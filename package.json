{
  "name": "Filmes",
  "version": "1.0.0",
  "description": "Catálogo de filmes e séries com TypeScript, Express e MySQL",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch api/src/servidor.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "verificar": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3"
  }
}
